{
  "name": "spotter-weather-routing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "test:cross-browser": "playwright test --config playwright.cross-browser.config.ts",
    "postinstall": "node scripts/patch-maplibre-security.mjs",
    "prebuild": "node scripts/patch-maplibre-security.mjs",
    "predev": "node scripts/patch-maplibre-security.mjs",
    "test:security": "node --test scripts/patch-maplibre-security.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "5.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
