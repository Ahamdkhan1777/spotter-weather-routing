DJANGO_DEBUG=true
SECRET_KEY=local-development-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOMTOM_API_KEY=
# Cargo weight is separate from the truck's empty weight. Adjust for the real vehicle.
TRUCK_EMPTY_WEIGHT_LB=18000
# Optional dimensions in meters; blank means unspecified to the routing provider.
TRUCK_HEIGHT_M=
TRUCK_WIDTH_M=
TRUCK_LENGTH_M=
PROVIDER_TIMEOUT_SECONDS=15
# Public endpoint is for non-commercial evaluation; commercial use requires a license.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
MAX_WEATHER_LOCATIONS=450
